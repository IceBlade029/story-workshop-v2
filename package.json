{
  "name": "story-workshop-v2",
  "version": "0.1.0",
  "description": "故事工坊 v2 — 大模型辅助故事创作桌面应用",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/entry.tsx --bundle --outfile=dist/renderer/bundle.js --platform=browser --jsx=automatic --loader:.tsx=tsx --loader:.ts=ts --loader:.css=css",
    "copy:html": "node -e \"const f=require('fs');f.mkdirSync('dist/renderer',{recursive:true});f.copyFileSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run copy:html",
    "test": "vitest run",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^42.1.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
